prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: p2p_core
Description: SwiftPeer P2P Core Library
Version: @PACKAGE_VERSION@
URL: https://github.com/your-username/SwiftPeer
Requires: 
Libs: -L${libdir} -lp2p_core
Cflags: -I${includedir}
